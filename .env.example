# ===================================================================
# KB FLOORING BD - SECURE EMAIL NOTIFICATION CONFIGURATION
# ===================================================================
# All contact form submissions are routed directly to: kbflooringbd@gmail.com
#
# Quick 1-Minute Setup with Gmail:
# 1. Go to your Google Account (https://myaccount.google.com/) for kbflooringbd@gmail.com
# 2. Select "Security" -> Make sure 2-Step Verification is ON.
# 3. Under "2-Step Verification", scroll down to "App Passwords".
# 4. Create a new App Password (name it "KB Flooring Website").
# 5. Copy the 16-character generated password and paste it into GMAIL_APP_PASSWORD below.
# ===================================================================

GMAIL_USER=kbflooringbd@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password_here

# Custom SMTP (Optional - defaults to smtp.gmail.com:465 if not set)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=kbflooringbd@gmail.com
# SMTP_PASS=your_16_character_app_password_here
